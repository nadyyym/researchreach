PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_POSTHOG_KEY=your-posthog-key
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Build-time only: GTM Supabase project that backs the 'researchers'
# content-layer loader (src/content/config.ts). Not PUBLIC_ — server/build-time.
RESEARCHERS_SUPABASE_URL=https://your-gtm-project.supabase.co
RESEARCHERS_SUPABASE_ANON_KEY=your-gtm-anon-or-publishable-key

# Server-only (request-time) SECRET. Used ONLY by the ORCID unlock endpoint
# (src/pages/api/researchers/[slug]/unlock/index.ts) to read RLS-protected ORCID
# tables that the anon/publishable key CANNOT read. Never PUBLIC_, never shipped
# to the browser, never required by the static build. Do not commit the real key.
RESEARCHERS_SUPABASE_SERVICE_KEY=your-gtm-service-role-key
